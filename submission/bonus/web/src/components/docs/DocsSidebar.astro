---
const sections = [
  {
    title: 'Giới thiệu',
    links: [
      { label: 'CDC là gì?', href: '#what-is-cdc' },
      { label: 'Tại sao dùng CDC?', href: '#why-cdc' },
      { label: 'Use cases', href: '#use-cases' },
    ],
  },
  {
    title: 'Kiến trúc',
    links: [
      { label: 'Debezium', href: '#debezium' },
      { label: 'Kafka', href: '#kafka' },
      { label: 'Lakehouse', href: '#lakehouse' },
    ],
  },
  {
    title: 'Triển khai',
    links: [
      { label: 'Setup MySQL', href: '#setup-mysql' },
      { label: 'Config Debezium', href: '#config-debezium' },
      { label: 'Running Pipeline', href: '#running-pipeline' },
    ],
  },
  {
    title: 'Tài liệu tham khảo',
    links: [
      { label: 'Debezium Docs', href: '#' },
      { label: 'Kafka Connect', href: '#' },
      { label: 'Delta Lake', href: '#' },
    ],
  },
];
---

<aside className="w-64 bg-slate-900 border-r border-slate-800 p-6 overflow-y-auto">
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-emerald-400">Tài liệu</h2>
    <p class="text-sm text-slate-500 mt-1">CDC Lakehouse</p>
  </div>

  <nav class="space-y-6">
    {sections.map(section => (
      <div>
        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">
          {section.title}
        </h3>
        <ul class="space-y-2">
          {section.links.map(link => (
            <li>
              <a
                href={link.href}
                class="block text-sm text-slate-300 hover:text-emerald-400 transition py-1"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<style>
  aside {
    min-width: 16rem;
  }
</style>
